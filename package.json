{
  "name": "letsplaycards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8789 --inspector-port 9232",
    "build": "node scripts/build-client.mjs && tailwindcss -i ./src/client/styles.css -o ./public/styles.css --minify && tsx scripts/build-glossary.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa:next": "tsx scripts/qa-next.ts",
    "d1:migrate": "wrangler d1 migrations apply letsplaycards --local",
    "d1:migrate:remote": "wrangler d1 migrations apply letsplaycards --remote",
    "ship": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260415.1",
    "@tailwindcss/cli": "^4.1.11",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "workerd"
    ]
  }
}
